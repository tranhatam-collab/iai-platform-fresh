# Repo on VPS must already contain:
# - apps/mail-api/dist
# - apps/mail-smtp/dist
# - root node_modules with smtp-server installed
MAIL_REPO_ROOT=/opt/iai-platform-worktree

# Host paths for sqlite state
MAIL_API_DATA_ROOT=/opt/iai-runtime/mail-api
MAIL_SMTP_DATA_ROOT=/opt/iai-runtime/mail-smtp

# Mailcow TLS cert mount
MAIL_TLS_CERTS_PATH=/opt/mailcow-dockerized/data/assets/ssl

# Host ports are localhost-only on purpose
MAIL_API_HOST_PORT=8787
MAIL_SMTP_PRIVATE_PORT=1587
MAIL_SMTP_HEALTH_HOST_PORT=9091

# SMTP runtime identity
LOG_LEVEL=info
MAIL_SMTP_HOSTNAME=smtp.mail.iai.one
MAIL_SMTP_BANNER=IAI Mail SMTP Submission (Internal)

# Internal-first remote mode
MAIL_SMTP_REMOTE_BASE_URL=http://mail-api:8787/v1/internal/smtp/
MAIL_SMTP_REMOTE_TOKEN=REPLACE_WITH_OPENSSL_RAND_HEX_32

# Queue/routing placeholders required by config loader
MAIL_SMTP_QUEUE_URL=redis://placeholder:6379/0
MAIL_SMTP_QUEUE_NAME=mail-smtp-submit
MAIL_SMTP_PRIMARY_ROUTE=transactional_primary
MAIL_SMTP_BACKUP_ROUTE=transactional_backup
MAIL_PROVIDER_DEFAULT=selfhosted

# Smoke defaults
SMTP_SMOKE_USER=smtp-dev
SMTP_SMOKE_PASS=dev-secret
SMTP_SMOKE_FROM=no-reply@tx.iai.one
SMTP_SMOKE_TO=deliverability-smoke@example.com
SMTP_SMOKE_SERVERNAME=smtp.mail.iai.one
