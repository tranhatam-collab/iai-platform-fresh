# Runtime
NODE_ENV=development
LOG_LEVEL=debug

# SMTP listener
MAIL_SMTP_BIND_ADDRESS=0.0.0.0
MAIL_SMTP_HOSTNAME=smtp.mail.iai.one
MAIL_SMTP_PORT=587
MAIL_SMTP_SECURE_PORT=465
MAIL_SMTP_BANNER=IAI Mail SMTP Submission

# TLS
MAIL_SMTP_STARTTLS_REQUIRED=true
MAIL_SMTP_REQUIRE_TLS_BEFORE_AUTH=true
MAIL_SMTP_TLS_MIN_VERSION=TLSv1.2
MAIL_SMTP_TLS_REJECT_UNAUTHORIZED=true
MAIL_SMTP_TLS_KEY_PATH=
MAIL_SMTP_TLS_CERT_PATH=
MAIL_SMTP_TLS_CA_PATH=

# AUTH + policy
MAIL_SMTP_BACKEND_MODE=stub
MAIL_SMTP_REMOTE_BASE_URL=http://localhost:8787/v1/internal/smtp/
MAIL_SMTP_REMOTE_TOKEN=
MAIL_SMTP_REMOTE_TIMEOUT_MS=5000
MAIL_SMTP_REMOTE_AUTH_PATH=auth
MAIL_SMTP_REMOTE_MAIL_FROM_PATH=mail-from
MAIL_SMTP_REMOTE_RECIPIENT_PATH=recipient
MAIL_SMTP_REMOTE_NORMALIZE_PATH=normalize
MAIL_SMTP_REMOTE_QUEUE_PATH=queue
MAIL_SMTP_REMOTE_AUDIT_PATH=audit
MAIL_SMTP_AUTH_METHODS=PLAIN,LOGIN
MAIL_SMTP_CREDENTIAL_STORE=database
MAIL_SMTP_DEFAULT_STREAM=transactional
MAIL_SMTP_ALLOW_HEADER_STREAM_OVERRIDE=true
MAIL_SMTP_ENFORCE_VERIFIED_DOMAINS=true
MAIL_SMTP_REJECT_SUPPRESSED_RECIPIENTS=true
MAIL_SMTP_MAX_RECIPIENTS=100
MAIL_SMTP_MAX_MESSAGE_SIZE_BYTES=20971520

# Core dependencies
MAIL_DB_URL=postgres://postgres:postgres@localhost:5432/iai_mail
MAIL_REDIS_URL=redis://localhost:6379/0
MAIL_SMTP_QUEUE_DRIVER=redis
MAIL_SMTP_QUEUE_URL=redis://localhost:6379/0
MAIL_SMTP_QUEUE_NAME=mail-smtp-submit

# Provider routing
MAIL_PROVIDER_DEFAULT=sendgrid
MAIL_SMTP_PRIMARY_ROUTE=transactional_primary
MAIL_SMTP_BACKUP_ROUTE=transactional_backup

# Local stub backend for dev smoke
MAIL_SMTP_DEV_AUTH_USER=smtp-dev
MAIL_SMTP_DEV_AUTH_PASS=dev-secret
MAIL_SMTP_DEV_WORKSPACE_ID=ws_dev
MAIL_SMTP_DEV_CREDENTIAL_ID=smtpcred_dev
MAIL_SMTP_DEV_ALLOWED_SENDERS=no-reply@tx.iai.one,system@sys.iai.one
MAIL_SMTP_DEV_VERIFIED_DOMAINS=tx.iai.one,sys.iai.one
MAIL_SMTP_DEV_ALLOWED_STREAMS=transactional,system
MAIL_SMTP_DEV_SUPPRESSED_RECIPIENTS=blocked@example.com

# Health + observability
MAIL_API_HEALTH_URL=http://localhost:8787/v1/health
MAIL_API_DEPENDENCIES_HEALTH_URL=http://localhost:8787/v1/health/dependencies
MAIL_SMTP_METRICS_ENABLED=true
MAIL_SMTP_METRICS_PORT=9090
MAIL_SMTP_HEALTH_BIND_ADDRESS=127.0.0.1
MAIL_SMTP_HEALTH_PORT=9091
