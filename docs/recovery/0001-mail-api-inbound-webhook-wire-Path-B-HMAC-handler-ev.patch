+    replayWindowSeconds: 300
+  });
+  assert.equal(result.ok, false);
+  if (!result.ok) {
+    assert.equal(result.code, "MAIL_WEBHOOK_TIMESTAMP_OUT_OF_WINDOW");
+  }
+});
+
+test("verifyInboundWebhook rejects bad signature", () => {
+  const ts = 1_777_777_777;
