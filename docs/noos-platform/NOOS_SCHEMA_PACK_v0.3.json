{
  "openapi": "3.1.0",
  "jsonSchemaDialect": "https://json-schema.org/draft/2020-12/schema",
  "info": {
    "title": "NOOS Schema Pack",
    "version": "0.3.0",
    "summary": "Production-lock machine-readable contract pack for NOOS as the IAI civilization operating system and control layer.",
    "description": "This contract pack locks the NOOS architecture surface, lifecycle, schema program, DTN assumptions, PQC trust direction, Vietnam deployment profile, and Mars latency lab profile. Execution is referenced only through Flow handoff contracts and must not bypass Flow."
  },
  "servers": [
    {
      "url": "https://api.noos.iai.one/v0.3",
      "description": "NOOS architecture and contract surface"
    },
    {
      "url": "https://api.flow.iai.one/v0.3",
      "description": "Flow execution runtime surface referenced by NOOS handoff contracts"
    }
  ],
  "tags": [
    {
      "name": "Missions",
      "description": "Mission model and references owned by NOOS"
    },
    {
      "name": "Twins",
      "description": "Twin contracts, latency profiles, and autonomy boundaries"
    },
    {
      "name": "Intents",
      "description": "Delay-tolerant intent submission and Flow handoff references"
    },
    {
      "name": "Evidence",
      "description": "Evidence-first records, relay path tracking, and attestation anchors"
    },
    {
      "name": "Federation",
      "description": "Federation rules, sovereignty classes, and delayed synchronization behavior"
    },
    {
      "name": "Profiles",
      "description": "Vietnam deployment profile and Mars latency lab contracts"
    }
  ],
  "security": [
    {
      "MutualTLS": []
    },
    {
      "AttestedBearer": []
    }
  ],
  "x-noos-status": "production-lock",
  "x-noos-boundary": {
    "noos": {
      "owns": [
        "mission-model",
        "twin-model",
        "policy-governance",
        "trust-security-model",
        "federation-logic",
        "delay-tolerant-behavior",
        "evidence-architecture",
        "system-constraints"
      ],
      "mustNot": [
        "execute-workflow",
        "run-automation-directly",
        "own-primary-operator-ui",
        "serve-as-business-dashboard"
      ]
    },
    "flow": {
      "owns": [
        "workflow-execution",
        "approval-queue-runtime",
        "scheduling",
        "retries",
        "rollback-execution",
        "command-execution"
      ]
    },
    "app": {
      "owns": [
        "operator-ui",
        "dashboard-surfaces",
        "human-review-experience",
        "role-based-access-experience"
      ]
    },
    "hardRules": [
      "execution-must-not-bypass-flow",
      "sensitive-actions-require-approval-rollback-evidence",
      "local-first-before-federation",
      "delay-is-default",
      "energy-constraints-are-mandatory"
    ]
  },
  "x-noos-commandLifecycle": {
    "name": "locked-command-lifecycle",
    "steps": [
      {
        "id": "intent",
        "owner": "noos",
        "requiredArtifacts": [
          "DelayTolerantIntent",
          "PolicyEnvelope",
          "FlowExecutionReference",
          "RollbackReference"
        ]
      },
      {
        "id": "policy-check",
        "owner": "noos",
        "requiredArtifacts": [
          "PolicyEnvelope"
        ]
      },
      {
        "id": "approval-queue",
        "owner": "flow",
        "requiredArtifacts": [
          "ApprovalRecord"
        ]
      },
      {
        "id": "execute",
        "owner": "flow",
        "requiredArtifacts": [
          "FlowExecutionReference"
        ]
      },
      {
        "id": "evidence-record",
        "owner": "noos",
        "requiredArtifacts": [
          "EvidenceRecord"
        ]
      },
      {
        "id": "rollback-ready",
        "owner": "flow",
        "requiredArtifacts": [
          "RollbackReference"
        ]
      },
      {
        "id": "federation-on-contact",
        "owner": "noos",
        "requiredArtifacts": [
          "FederationPolicy",
          "ContactWindow"
        ]
      }
    ]
  },
  "x-noos-trustProfile": {
    "mode": "pqc-native",
    "requiredAlgorithms": {
      "keyExchange": "ML-KEM",
      "signing": "ML-DSA",
      "longTermSignature": "SLH-DSA"
    },
    "legacyOnlyTransportForbidden": true,
    "attestationRequired": true
  },
  "x-noos-testMatrix": {
    "core": [
      "approval-delay",
      "missing-approval",
      "rollback-before-rollout",
      "policy-mismatch",
      "stale-policy",
      "lost-connection",
      "duplicate-delivery",
      "replay-attack-simulation"
    ],
    "degraded": [
      "lost-satellite",
      "lost-gateway",
      "lost-policy-sync",
      "low-energy",
      "device-isolation"
    ],
    "marsLatency": [
      "no-realtime-control",
      "local-autonomy-must-work",
      "delayed-approval-must-still-be-valid",
      "rollback-after-delay-must-succeed"
    ]
  },
  "paths": {
    "/missions/{missionId}": {
      "get": {
        "tags": [
          "Missions"
        ],
        "summary": "Get a mission contract",
        "operationId": "getMission",
        "parameters": [
          {
            "$ref": "#/components/parameters/MissionId"
          }
        ],
        "responses": {
          "200": {
            "description": "Mission contract",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Mission"
                },
                "examples": {
                  "wildfireMission": {
                    "$ref": "#/components/examples/MissionWildfireVietnam"
                  }
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/Problem"
          }
        }
      }
    },
    "/twins/{twinId}": {
      "get": {
        "tags": [
          "Twins"
        ],
        "summary": "Get an interplanetary twin contract",
        "operationId": "getTwin",
        "parameters": [
          {
            "$ref": "#/components/parameters/TwinId"
          }
        ],
        "responses": {
          "200": {
            "description": "Twin contract",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InterplanetaryTwin"
                },
                "examples": {
                  "highlandsTwin": {
                    "$ref": "#/components/examples/TwinCentralHighlands"
                  }
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/Problem"
          }
        }
      }
    },
    "/intents/delay-tolerant": {
      "post": {
        "tags": [
          "Intents"
        ],
        "summary": "Submit a delay-tolerant intent for policy evaluation and Flow handoff",
        "operationId": "createDelayTolerantIntent",
        "x-noos-flowHandoffRequired": true,
        "x-noos-executionBypassForbidden": true,
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DelayTolerantIntent"
              },
              "examples": {
                "marsApprovalIntent": {
                  "$ref": "#/components/examples/DelayTolerantIntentMars"
                }
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Intent accepted for policy evaluation and Flow handoff",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DelayTolerantIntentReceipt"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Problem"
          }
        }
      }
    },
    "/evidence-records/{evidenceId}": {
      "get": {
        "tags": [
          "Evidence"
        ],
        "summary": "Get an evidence record",
        "operationId": "getEvidenceRecord",
        "parameters": [
          {
            "$ref": "#/components/parameters/EvidenceId"
          }
        ],
        "responses": {
          "200": {
            "description": "Evidence record",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EvidenceRecord"
                },
                "examples": {
                  "relayEvidence": {
                    "$ref": "#/components/examples/EvidenceRelayRecord"
                  }
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/Problem"
          }
        }
      }
    },
    "/federation-policies/{policyId}": {
      "get": {
        "tags": [
          "Federation"
        ],
        "summary": "Get a federation policy",
        "operationId": "getFederationPolicy",
        "parameters": [
          {
            "$ref": "#/components/parameters/PolicyId"
          }
        ],
        "responses": {
          "200": {
            "description": "Federation policy",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FederationPolicy"
                },
                "examples": {
                  "regionalPolicy": {
                    "$ref": "#/components/examples/FederationPolicyVietnam"
                  }
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/Problem"
          }
        }
      }
    },
    "/profiles/vietnam": {
      "get": {
        "tags": [
          "Profiles"
        ],
        "summary": "Get the Vietnam resilience profile",
        "operationId": "getVietnamProfile",
        "responses": {
          "200": {
            "description": "Vietnam resilience profile",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VietnamProfile"
                }
              }
            }
          }
        }
      }
    },
    "/labs/mars-latency": {
      "get": {
        "tags": [
          "Profiles"
        ],
        "summary": "Get the Mars latency lab profile",
        "operationId": "getMarsLatencyLabProfile",
        "responses": {
          "200": {
            "description": "Mars latency lab profile",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MarsLatencyLabProfile"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "MutualTLS": {
        "type": "mutualTLS",
        "description": "Mutual TLS transport for attested NOOS and Flow links.",
        "x-noos-pqcCompatible": true
      },
      "AttestedBearer": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "attested-token",
        "description": "Bearer token backed by attestation and PQC-compatible signing."
      }
    },
    "parameters": {
      "MissionId": {
        "name": "missionId",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string",
          "pattern": "^[a-z0-9._:-]{3,128}$"
        }
      },
      "TwinId": {
        "name": "twinId",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string",
          "pattern": "^[a-z0-9._:-]{3,128}$"
        }
      },
      "EvidenceId": {
        "name": "evidenceId",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string",
          "pattern": "^[a-z0-9._:-]{3,128}$"
        }
      },
      "PolicyId": {
        "name": "policyId",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string",
          "pattern": "^[a-z0-9._:-]{3,128}$"
        }
      }
    },
    "responses": {
      "Problem": {
        "description": "Structured error",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Problem"
            }
          }
        }
      }
    },
    "examples": {
      "MissionWildfireVietnam": {
        "summary": "Vietnam wildfire mission contract",
        "value": {
          "id": "mission.vn-central-highlands.wildfire.2026-01",
          "name": "Central Highlands Wildfire Containment",
          "class": "wildfire",
          "regionCode": "vn_central_highlands",
          "status": "planned",
          "twinRefs": [
            "twin.habitat.vn-central-highlands-01",
            "twin.relay.vn-relay-plateau-01"
          ],
          "policyEnvelopeRef": "policy.vn.wildfire.ops.v1",
          "flowExecutionRef": {
            "id": "flowref.vn.wildfire.deploy",
            "runtime": "flow.iai.one",
            "workflowRef": "flow.workflow.wildfire.containment.v3",
            "approvalQueueRef": "flow.approvals.vn.wildfire",
            "schedulerClass": "delay-tolerant"
          },
          "rollbackRef": {
            "id": "rollback.vn.wildfire.deploy",
            "workflowRef": "flow.workflow.wildfire.rollback.v1",
