      },
      "FederationPolicyVietnam": {
        "summary": "Vietnam regional federation policy",
        "value": {
          "id": "policy.federation.vn.regional.v1",
          "scope": "region",
          "allowedData": [
            "telemetry-summary",
            "wildfire-alerts",
            "energy-state"
          ],
          "conflictResolution": "priority",
          "approvalThreshold": "human-required",
          "humanVetoRequired": true,
          "latencyTolerance": "high",
          "localOverride": true
        }
      }
    },
    "schemas": {
      "Mission": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "class",
          "regionCode",
          "status",
          "twinRefs",
          "policyEnvelopeRef",
          "flowExecutionRef",
          "rollbackRef",
          "energyConstraintProfile",
          "degradedBehaviorRef",
          "evidenceRetentionClass",
          "marsLatencyTestRequired"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9._:-]{3,128}$"
          },
          "name": {
            "type": "string",
            "minLength": 3,
            "maxLength": 160
          },
          "class": {
            "type": "string",
            "enum": [
              "wildfire",
              "flood-dam",
              "agriculture",
              "energy-grid",
              "remote-health",
              "island-maritime",
              "space-habitat",
              "relay-maintenance"
            ]
          },
          "regionCode": {
            "type": "string",
            "pattern": "^[a-z0-9_-]{2,64}$"
          },
          "status": {
            "type": "string",
            "enum": [
              "planned",
              "active",
              "degraded",
              "paused",
              "completed",
              "rolled-back"
            ]
          },
          "twinRefs": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9._:-]{3,128}$"
            }
          },
          "policyEnvelopeRef": {
            "type": "string",
            "pattern": "^[a-z0-9._:-]{3,128}$"
          },
          "flowExecutionRef": {
            "$ref": "#/components/schemas/FlowExecutionReference"
          },
          "rollbackRef": {
            "$ref": "#/components/schemas/RollbackReference"
          },
          "energyConstraintProfile": {
            "$ref": "#/components/schemas/EnergyConstraintProfile"
          },
          "degradedBehaviorRef": {
            "type": "string",
            "pattern": "^[a-z0-9._:-]{3,128}$"
          },
          "evidenceRetentionClass": {
            "type": "string",
            "enum": [
              "short",
              "long",
              "permanent"
            ]
          },
          "marsLatencyTestRequired": {
            "type": "boolean"
          }
        }
      },
      "InterplanetaryTwin": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "type",
          "latencyProfile",
          "autonomyMode",
          "energyProfile",
          "federationLevel",
          "contactWindows",
          "sovereigntyScope",
          "degradedBehaviorRef",
          "evidenceRetentionClass"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9._:-]{3,128}$"
          },
          "type": {
            "type": "string",
            "enum": [
              "habitat",
              "region",
              "device",
              "human",
              "energy",
              "relay"
            ]
          },
          "latencyProfile": {
            "type": "string",
            "enum": [
              "earth",
              "mars",
              "deep-space",
              "vn-remote"
            ]
          },
          "autonomyMode": {
            "type": "string",
            "enum": [
              "full",
              "bounded",
              "assist"
            ]
          },
          "energyProfile": {
            "type": "string",
            "enum": [
              "critical",
              "limited",
              "normal",
              "surplus"
            ]
          },
          "federationLevel": {
            "type": "string",
            "enum": [
              "none",
              "local",
              "regional",
              "global"
            ]
          },
          "contactWindows": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ContactWindow"
            }
          },
          "sovereigntyScope": {
            "type": "string",
            "enum": [
              "local",
              "national",
              "cross-border"
            ]
          },
          "degradedBehaviorRef": {
            "type": "string",
            "pattern": "^[a-z0-9._:-]{3,128}$"
          },
          "evidenceRetentionClass": {
            "type": "string",
            "enum": [
              "short",
              "long",
              "permanent"
            ]
          }
        }
      },
      "DelayTolerantIntent": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "actor",
          "target",
          "action",
          "approvalState",
          "workflowRef",
          "rollbackRef",
          "expectedDeliveryWindow",
          "priorityOnReconnect",
          "notAfter",
          "localAutonomyAllowed",
          "degradedModePolicy",
          "routeMode",
          "custodyChain",
          "policyEnvelope"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9._:-]{3,160}$"
          },
          "actor": {
            "type": "string",
            "pattern": "^[A-Za-z0-9._:-]{3,160}$"
          },
          "target": {
            "type": "string",
            "pattern": "^[A-Za-z0-9._:-]{3,160}$"
          },
          "action": {
            "type": "string",
            "minLength": 3,
            "maxLength": 200
          },
          "approvalState": {
            "type": "string",
            "enum": [
              "pending",
              "approved",
              "rejected"
            ]
          },
          "workflowRef": {
            "type": "string",
            "pattern": "^[a-z0-9._:-]{3,160}$"
          },
          "rollbackRef": {
            "type": "string",
            "pattern": "^[a-z0-9._:-]{3,160}$"
          },
          "expectedDeliveryWindow": {
            "type": "string",
            "format": "date-time"
          },
          "priorityOnReconnect": {
            "type": "string",
            "enum": [
              "low",
              "normal",
              "high",
              "critical"
            ]
          },
          "notAfter": {
            "type": "string",
            "format": "date-time"
          },
          "localAutonomyAllowed": {
            "type": "boolean"
          },
          "degradedModePolicy": {
            "type": "string",
